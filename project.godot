; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="first-person-dungeon-crawler"
run/main_scene="res://scenes/title.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[display]

; A phone game held upright. 540x960 is the design resolution everything is
; laid out against; canvas_items scales the whole UI to whatever the device
; actually has, and "expand" hands a taller or shorter phone the extra space
; as viewport rather than as black bars. Without any of this Godot renders the
; UI at native pixel size, which is why the menus ran off the edge of a phone.
window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
